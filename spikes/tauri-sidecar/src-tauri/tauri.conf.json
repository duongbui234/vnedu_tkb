{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TKB Sidecar Spike",
  "version": "0.1.0",
  "identifier": "vn.vnedu.tkb.sidecarspike",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "TKB Sidecar Spike", "width": 760, "height": 520 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["core/**/*"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
